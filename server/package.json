{
  "name": "elite-evening-payments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Payment service for Elite Evening Design — order creation, hosted checkout, webhook verification and reconciliation.",
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.3"
  }
}
