---
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { site, location, mapsUrl } from '~/config/site';
import {
  t, dirOf, localePath, LOCALES, HREFLANG, OG_LOCALE, DEFAULT_LOCALE, type Locale,
} from '~/i18n';
import '~/styles/app.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Use the title exactly as given, without appending the house name. */
  titleExact?: boolean;
  variant?: 'over' | 'solid';
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Path without a locale prefix, e.g. '/collections/bridal'. Drives hreflang. */
  path: string;
  /**
   * False for a page that exists in one language only — the ledger, the
   * not-found page. The language switcher then offers each language's home
   * rather than a translation of this path that was never built, and no
   * hreflang is claimed for addresses that do not exist.
   */
  translated?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale, title, description, titleExact = false,
  variant = 'solid', image = site.ogImage,
  type = 'website', noindex = false, path, schema, translated = true,
} = Astro.props;

const dict = t(locale);
const dir = dirOf(locale);
const fullTitle = titleExact ? title : `${title} — ${site.name}`;
const canonical = new URL(localePath(path, locale), site.url).href;
const ogImage = new URL(image, site.url).href;

// A LocalBusiness rather than a plain Organization: the atelier has a street
// address and a telephone line, which is what local search needs to place it.
const organization = {
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: site.shortName,
  url: site.url,
  slogan: dict.tagline,
  description: dict.seo.home.description,
  logo: { '@type': 'ImageObject', url: new URL('/brand/icon-512.png', site.url).href, width: 512, height: 512 },
  image: ogImage,
  sameAs: [site.instagram.url],
  ...(site.contact.phone ? { telephone: site.contact.phone.replace(/[^\d+]/g, '') } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: location.street,
    addressLocality: location.city,
    addressCountry: location.countryCode,
  },
  hasMap: mapsUrl,
  areaServed: { '@type': 'City', name: location.city },
  availableLanguage: LOCALES.map((l) => HREFLANG[l]),
};

const graph = [organization, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang={HREFLANG[locale]} dir={dir} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* every language of this page, plus the default for anything unmatched */}
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={HREFLANG[l]} href={new URL(localePath(translated ? path : '/', l), site.url).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(translated ? path : '/', DEFAULT_LOCALE), site.url).href} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${dict.tagline}`} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f5f0e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131110" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/cormorant-garamond-300-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-300-latin.woff2" as="font" type="font/woff2" crossorigin />
    {locale === 'he' && (
      <link rel="preload" href="/fonts/frank-ruhl-libre-300-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    )}
    {locale === 'ar' && (
      <link rel="preload" href="/fonts/amiri-400-arabic.woff2" as="font" type="font/woff2" crossorigin />
    )}

    <script set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} type="application/ld+json" is:inline />
  </head>

  <body>
    <a class="skip" href="#main">{dict.ui.skip}</a>
    <SiteHeader locale={locale} variant={variant} path={path} switchTo={translated ? path : '/'} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script>import '~/scripts/ui';</script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
  /* page transition: a short cross-fade, nothing theatrical */
  @view-transition { navigation: auto; }
  ::view-transition-old(root) { animation: vt-out .22s var(--ease) both; }
  ::view-transition-new(root) { animation: vt-in .34s var(--ease) both; }
  @keyframes vt-out { to { opacity: 0; } }
  @keyframes vt-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  }
</style>
