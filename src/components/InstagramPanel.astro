---
import { site } from '~/config/site';
import { t, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="ig ink" aria-labelledby="ig-h">
  <div class="wrap ig__in reveal">
    <div class="ig__text">
      <p class="label eyebrow">{dict.instagram.eyebrow}</p>
      <h2 class="t-h2 ig__h" id="ig-h">{dict.instagram.title} {dict.instagram.accent}</h2>
    </div>
    <a class="ig__a" href={site.instagram.url} target="_blank" rel="noopener noreferrer" dir="ltr">
      <span class="ig__handle">@{site.instagram.handle}</span>
      <span class="arw" aria-hidden="true">&#8599;</span>
    </a>
  </div>
</section>

<style>
  .ig { padding-block: var(--section-close); }
  .ig__in {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .ig__text { display: flex; flex-direction: column; gap: .9rem; }
  .ig__h { margin: 0; }

  .ig__a {
    display: inline-flex;
    align-items: baseline;
    gap: .7rem;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    font-weight: 300;
    color: var(--on-ink);
    padding-bottom: .4rem;
    border-bottom: 1px solid var(--line-on-ink);
    transition: border-color .4s var(--ease), color .4s var(--ease);
  }
  .ig__a:hover { color: var(--gold-lit); border-bottom-color: var(--gold-lit); }
</style>
