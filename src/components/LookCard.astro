---
import Plate from './Plate.astro';
import { lookTitle } from '~/data/looks';
import type { Look } from '~/data/types';

interface Props {
  look: Look;
  collectionName: string;
  sizes?: string;
  delay?: number;
  priority?: boolean;
}
const { look, collectionName, sizes = '(max-width: 720px) 86vw, (max-width: 1100px) 44vw, 30vw', delay = 0, priority = false } = Astro.props;
const plate = look.plates[0];
---

<article class="lookcard reveal" style={`--reveal-delay:${delay}ms`}>
  <a class="lookcard__a" href={`/looks/${look.slug}`}>
    <Plate {...plate} sizes={sizes} priority={priority} class="lookcard__plate" />
    <div class="lookcard__meta">
      <h3 class="lookcard__title">{lookTitle(look)}</h3>
      <p class="label lookcard__line">{collectionName}</p>
    </div>
    <p class="lookcard__note">{look.note}</p>
  </a>
</article>

<style>
  .lookcard__a { display: block; }
  .lookcard :global(.lookcard__plate) { margin-bottom: 1.1rem; }
  .lookcard__a:hover :global(.lookcard__plate img) { transform: scale(1.045); }

  .lookcard__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .65rem;
    border-bottom: 1px solid var(--line);
    transition: border-color .5s var(--ease);
  }
  .lookcard__a:hover .lookcard__meta { border-bottom-color: var(--line-strong); }

  .lookcard__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 1.35rem;
    letter-spacing: .01em;
  }
  .lookcard__line { color: var(--gold-ink); }
  .lookcard__note {
    margin-top: .8rem;
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 34ch;
  }
</style>
