---
import Plate from './Plate.astro';
import { formatPrice } from '~/lib/price';
import type { LookEntry } from '~/content';
import { t, localePath, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
  look: LookEntry;
  collectionName: string;
  sizes?: string;
  priority?: boolean;
}
const { locale, look, collectionName, sizes = '(max-width: 720px) 86vw, (max-width: 1100px) 44vw, 30vw', priority = false } = Astro.props;
const dict = t(locale);
// A look the atelier has only written a note for still holds its place in the grid.
const plate = look.plates[0] ?? { alt: '', ratio: '2/3' as const, tone: 'linen' as const };
---

<article class="lookcard">
  <a class="lookcard__a" href={localePath(`/looks/${look.slug}`, locale)}>
    <Plate {...plate} sizes={sizes} priority={priority} class="lookcard__plate" />
    <div class="lookcard__meta">
      <h3 class="lookcard__title">{dict.ui.lookTitle(look.index)}</h3>
      <p class="label lookcard__line">
        {look.price ? formatPrice(look.price)
          : look.hire ? `${dict.lookPage.hire} · ${formatPrice(look.hire)}`
          : collectionName}
      </p>
    </div>
    <p class="lookcard__note">{look.note}</p>
  </a>
</article>

<style>
  .lookcard__a { display: block; }
  .lookcard :global(.lookcard__plate) { margin-bottom: 1.1rem; }
  .lookcard__a:hover :global(.lookcard__plate img) { transform: scale(1.045); }

  .lookcard__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .65rem;
    border-bottom: 1px solid var(--line);
    transition: border-color .5s var(--ease);
  }
  .lookcard__a:hover .lookcard__meta { border-bottom-color: var(--line-strong); }

  .lookcard__title { font-family: var(--serif); font-weight: 300; font-size: 1.35rem; letter-spacing: .01em; }
  .lookcard__line { color: var(--gold-ink); }
  .lookcard__note {
    margin-top: .8rem;
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 34ch;
  }
</style>
