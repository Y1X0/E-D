---
import Wordmark from './Wordmark.astro';
import { site } from '~/config/site';
import { t, localePath, LOCALES, LOCALE_LABEL, LOCALE_SHORT, HREFLANG, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
  /** 'over' floats the header on a dark hero; 'solid' sits on paper. */
  variant?: 'over' | 'solid';
  /** Path without a locale prefix — the switcher keeps you on the same page. */
  path: string;
}
const { locale, variant = 'solid', path } = Astro.props;
const dict = t(locale);

const nav = [
  { label: dict.nav.collections, href: '/collections' },
  { label: dict.nav.bespoke, href: '/bespoke' },
  { label: dict.nav.gallery, href: '/gallery' },
  { label: dict.nav.about, href: '/about' },
  { label: dict.nav.contact, href: '/contact' },
];

const current = path.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
---

<header class="hdr" data-variant={variant} data-solid={variant === 'solid' ? 'true' : 'false'}>
  <div class="hdr__in">
    <Wordmark href={localePath('/', locale)} class="hdr__mark" />

    <nav class="hdr__nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={localePath(item.href, locale)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__end">
      <nav class="lang" aria-label={dict.ui.language}>
        <ul>
          {LOCALES.map((l) => (
            <li>
              <a
                href={localePath(path, l)}
                lang={HREFLANG[l]}
                hreflang={HREFLANG[l]}
                aria-current={l === locale ? 'true' : undefined}
                aria-label={LOCALE_LABEL[l]}
              >{LOCALE_SHORT[l]}</a>
            </li>
          ))}
        </ul>
      </nav>

      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="menu">
        <span class="hdr__bars" aria-hidden="true"><i></i><i></i></span>
        <span class="sr-only">{dict.ui.menu}</span>
      </button>
    </div>
  </div>
</header>

<div class="menu ink" id="menu" hidden>
  <nav class="menu__nav" aria-label="Primary, expanded">
    <ul>
      {nav.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={localePath(item.href, locale)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="menu__foot" style={`--i:${nav.length}`}>
    <a class="link" href={site.instagram.url} rel="me noopener noreferrer" target="_blank">
      Instagram <span class="arw" aria-hidden="true">&#8599;</span>
    </a>
    <p class="label">{dict.tagline}</p>
  </div>
</div>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: background-color .45s var(--ease), color .45s var(--ease), border-color .45s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .hdr[data-variant='over'] { color: var(--on-ink); }
  .hdr[data-solid='true'] {
    background: var(--paper);
    color: var(--ink);
    border-bottom-color: var(--line);
  }

  .hdr__in {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .hdr__mark { --wm-size: clamp(.82rem, 1.35vw, 1rem); }
  .hdr[data-variant='over'][data-solid='false'] :global(.hdr__mark) { --wm-sub: var(--gold-lit); }

  .hdr__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 2.6rem);
    list-style: none;
    margin: 0; padding: 0;
  }
  .hdr__nav a {
    position: relative;
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    padding-block: .4rem;
    white-space: nowrap;
  }
  .hdr__nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0; bottom: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: var(--origin-end);
    transition: transform .45s var(--ease);
  }
  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current='page']::after { transform: scaleX(1); transform-origin: var(--origin-start); }
  .hdr__nav a[aria-current='page'] { color: var(--gold-ink); }
  .hdr[data-variant='over'][data-solid='false'] .hdr__nav a[aria-current='page'] { color: var(--gold-lit); }

  .hdr__end { display: flex; align-items: center; gap: clamp(.75rem, 1.6vw, 1.5rem); }

  /* ---- language switcher ---- */
  .lang ul {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0; padding: 0;
  }
  .lang li + li { border-inline-start: 1px solid currentColor; }
  .lang a {
    display: block;
    padding-inline: .55rem;
    font-size: var(--t-label);
    letter-spacing: .12em;
    line-height: 1;
    /* .7 keeps the inactive languages quiet while still clearing AA on both
       the paper header and the dark one */
    opacity: .7;
    transition: opacity .35s var(--ease), color .35s var(--ease);
  }
  .lang a:hover { opacity: 1; }
  .lang a[aria-current='true'] { opacity: 1; color: var(--gold-ink); }
  .hdr[data-variant='over'][data-solid='false'] .lang a[aria-current='true'] { color: var(--gold-lit); }
  .lang li + li { border-color: color-mix(in srgb, currentColor 28%, transparent); }

  .hdr__toggle { display: none; padding: .75rem; margin-inline-end: -.75rem; }
  .hdr__bars { display: block; width: 26px; }
  .hdr__bars i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform .45s var(--ease), opacity .3s var(--ease);
  }
  .hdr__bars i + i { margin-top: 7px; }
  .hdr__toggle[aria-expanded='true'] .hdr__bars i:first-child { transform: translateY(4px) rotate(45deg); }
  .hdr__toggle[aria-expanded='true'] .hdr__bars i:last-child { transform: translateY(-4px) rotate(-45deg); }

  /* ---- overlay menu ---- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 2.5rem;
    opacity: 0;
    transition: opacity .4s var(--ease);
  }
  .menu[hidden] { display: none; }
  .menu.is-open { opacity: 1; }

  .menu__nav ul { list-style: none; margin: 0; padding: 0; }
  .menu__nav li + li { margin-top: .15em; }
  .menu__nav a {
    display: block;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.2rem, 10vw, 3.6rem);
    line-height: 1.22;
    letter-spacing: -.015em;
  }
  .menu__nav a[aria-current='page'] { color: var(--gold-lit); }

  /* the list and its footer rise together, as one */
  .menu__nav,
  .menu__foot {
    transform: translate3d(0, 14px, 0);
    transition: transform .45s var(--ease) .05s, opacity .4s var(--ease) .05s;
    opacity: 0;
  }
  .menu.is-open .menu__nav,
  .menu.is-open .menu__foot { transform: none; opacity: 1; }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-on-ink);
  }

  @media (max-width: 940px) {
    .hdr__nav { display: none; }
    .hdr__toggle { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__nav, .menu__foot { transform: none; opacity: 1; transition: none; }
  }
</style>
