---
import { site } from '~/config/site';
import { collections } from '~/data/collections';
import { t, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.contact;
const { formEndpoint, email } = site.contact;

/** Messages the script shows; passed as data so it stays language-agnostic. */
const ig = site.instagram;
const igLink = '<a href="' + ig.url + '" target="_blank" rel="noopener noreferrer" dir="ltr">@' + ig.handle + '</a>';
const igPlain = '<a href="' + ig.url + '" target="_blank" rel="noopener noreferrer">Instagram</a>';
const strong = (text: string) => '<strong>' + text + '</strong> ';

const messages = {
  sent: strong(c.sent) + c.sentBody,
  failed: strong(c.failed) + c.failedBody.replace('Instagram', igPlain),
  mail: strong(c.mailOpening) + c.mailOpeningBody,
  ig: strong(c.igTitle) + c.igBody(ig.handle).replace('@' + ig.handle, igLink),
  subject: c.formTitle,
};
---

<form
  class="form"
  method="post"
  action={formEndpoint || undefined}
  data-endpoint={formEndpoint}
  data-email={email}
  data-messages={JSON.stringify(messages)}
>
  <div class="form__grid">
    <p class="field">
      <label class="label" for="f-name">{c.name}</label>
      <input id="f-name" name="name" type="text" autocomplete="name" required />
    </p>

    <p class="field">
      <label class="label" for="f-contact">{c.contactField}</label>
      <input id="f-contact" name="contact" type="text" autocomplete="email" required placeholder={c.contactPlaceholder} />
    </p>

    <p class="field">
      <label class="label" for="f-type">{c.enquiry}</label>
      <span class="select">
        <select id="f-type" name="enquiry">
          {collections.map((col) => (
            <option value={dict.collections[col.slug].name}>{dict.collections[col.slug].name}</option>
          ))}
          <option value={c.somethingElse}>{c.somethingElse}</option>
        </select>
      </span>
    </p>

    <p class="field">
      <label class="label" for="f-date">{c.date} <span class="field__opt">{c.optional}</span></label>
      <input id="f-date" name="date" type="date" />
    </p>

    <p class="field field--wide">
      <label class="label" for="f-message">{c.message}</label>
      <textarea id="f-message" name="message" rows="4" placeholder={c.messagePlaceholder}></textarea>
    </p>
  </div>

  <div class="form__foot">
    <button class="cta cta--solid form__send" type="submit">
      {c.send} <span class="arw" aria-hidden="true">&#8594;</span>
    </button>
    <p class="form__note">{c.privacy}</p>
  </div>

  <div class="form__status" role="status" aria-live="polite" hidden></div>
</form>

<style>
  .form { display: flex; flex-direction: column; gap: 2.25rem; }

  .form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.85rem 2.5rem;
  }
  .field { display: flex; flex-direction: column; gap: .7rem; margin: 0; }
  .field--wide { grid-column: 1 / -1; }
  .field__opt { text-transform: none; letter-spacing: .04em; color: var(--ink-muted); }

  .field input,
  .field textarea,
  .select select {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    padding: .55rem 0 .8rem;
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 300;
    color: var(--ink);
    border-radius: 0;
    transition: border-color .4s var(--ease);
  }
  .field textarea { resize: vertical; min-height: 6.5rem; line-height: 1.65; }
  .field input::placeholder,
  .field textarea::placeholder { color: color-mix(in srgb, var(--ink-muted) 62%, transparent); }
  .field input:hover, .field textarea:hover, .select select:hover { border-bottom-color: var(--ink-muted); }
  .field input:focus, .field textarea:focus, .select select:focus { border-bottom-color: var(--gold); }
  .field input:focus-visible, .field textarea:focus-visible, .select select:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }
  /* dates and phone numbers stay left-to-right in every language */
  .field input[type='date'] { direction: ltr; text-align: start; }

  .select { position: relative; display: block; }
  .select select { appearance: none; cursor: pointer; padding-inline-end: 2rem; }
  .select::after {
    content: '';
    position: absolute;
    inset-inline-end: .35rem; top: 50%;
    width: .5rem; height: .5rem;
    border-right: 1px solid var(--ink-muted);
    border-bottom: 1px solid var(--ink-muted);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; }
  .form__send[disabled] { opacity: .55; pointer-events: none; }
  .form__note { font-size: var(--t-small); color: var(--ink-muted); max-width: 38ch; line-height: 1.6; }

  .form__status {
    padding: 1.4rem 1.6rem;
    border: 1px solid var(--line-gold);
    background: color-mix(in srgb, var(--gold) 7%, transparent);
    font-size: var(--t-small);
    line-height: 1.65;
  }
  .form__status[hidden] { display: none; }
  .form__status :global(a) { color: var(--gold-ink); text-decoration: underline; text-underline-offset: .25em; }
  .form__status :global(strong) { font-weight: 400; }

  @media (max-width: 700px) {
    .form__grid { grid-template-columns: 1fr; gap: 1.6rem; }
  }
</style>

<script>
  import { onReady } from '~/scripts/ready';

  function initForm() {
    const form = document.querySelector<HTMLFormElement>('.form');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('.form__send')!;
    const { endpoint, email } = form.dataset as Record<string, string>;
    const msg = JSON.parse(form.dataset.messages || '{}');

    const show = (html: string) => {
      status.innerHTML = html;
      status.hidden = false;
      status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };

    const summarise = (d: FormData) =>
      [
        `${d.get('enquiry')}`,
        `${d.get('name')}`,
        `${d.get('contact')}`,
        d.get('date') ? `${d.get('date')}` : '',
        '',
        String(d.get('message') || ''),
      ].filter(Boolean).join('\n');

    form.addEventListener('submit', async (e) => {
      if (!form.reportValidity()) return;
      const data = new FormData(form);

      // 1. A real endpoint is configured — post it.
      if (endpoint) {
        e.preventDefault();
        button.disabled = true;
        try {
          const res = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          show(msg.sent);
        } catch {
          show(msg.failed);
        } finally {
          button.disabled = false;
        }
        return;
      }

      // 2. A published address — hand the enquiry to the mail client.
      if (email) {
        e.preventDefault();
        window.location.href =
          `mailto:${email}?subject=${encodeURIComponent(msg.subject)}&body=${encodeURIComponent(summarise(data))}`;
        show(msg.mail);
        return;
      }

      // 3. Nothing published yet — Instagram is the atelier's live channel.
      e.preventDefault();
      show(msg.ig);
    });
  }

  onReady(initForm);
</script>
