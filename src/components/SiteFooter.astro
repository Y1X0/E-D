---
import Wordmark from './Wordmark.astro';
import { site, contactChannels, location, mapsUrl } from '~/config/site';
import { getContent } from '~/content';
import { t, localePath, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const { collections } = await getContent(locale);

type ChannelId = 'whatsapp' | 'instagram' | 'phone' | 'email';
const NOTE = { whatsapp: 'noteWhatsapp', instagram: 'noteInstagram', phone: 'notePhone', email: 'noteEmail' } as const;
const NAME = { whatsapp: 'channelWhatsapp', instagram: 'channelInstagram', phone: 'channelPhone', email: 'channelEmail' } as const;

const channels = contactChannels().map((c) => ({
  ...c,
  note: dict.contact[NOTE[c.id as ChannelId]],
  // The atelier answers WhatsApp and the telephone on the same line, so the
  // footer printed one number twice with nothing to tell the two apart. Each
  // now carries its name, in the language being read.
  name: dict.contact[NAME[c.id as ChannelId]],
}));

const atelierLinks = [
  { label: dict.nav.bespoke, href: '/bespoke' },
  { label: dict.nav.gallery, href: '/gallery' },
  { label: dict.nav.about, href: '/about' },
  { label: dict.nav.contact, href: '/contact' },
  // what a buyer is owed before she pays, reachable from every page
  { label: dict.terms.title, href: '/terms' },
];
const year = new Date().getFullYear();
---

<footer class="ft ink">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <img class="ft__seal" src="/brand/seal.webp" width="96" height="96" alt="" loading="lazy" decoding="async" />
        <Wordmark href={null} class="ft__mark" />
        <p class="ft__tag">{dict.tagline}</p>
        <a class="ft__addr" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          <span>{location.street}, {location.city}</span>
          <span class="ft__addr-local" lang={location.localLang} dir="rtl">{location.streetLocal}, {location.cityLocal}</span>
        </a>
      </div>

      <nav class="ft__cols" aria-label="Footer">
        <div class="ft__col">
          <h2 class="label">{dict.footer.collections}</h2>
          <ul>
            {collections.map((c) => (
              <li><a href={localePath(`/collections/${c.slug}`, locale)}>{c.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="ft__col">
          <h2 class="label">{dict.footer.atelier}</h2>
          <ul>
            {atelierLinks.map((n) => <li><a href={localePath(n.href, locale)}>{n.label}</a></li>)}
          </ul>
        </div>
        <div class="ft__col">
          <h2 class="label">{dict.footer.enquiries}</h2>
          <ul>
            {channels.map((ch) => (
              <li class="ft__ch">
                <a
                  href={ch.href}
                  {...ch.id === 'instagram' || ch.id === 'whatsapp'
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {}}
                >
                  <span class="ft__chName">{ch.name}</span>
                  <span dir="ltr">{ch.value}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <div class="ft__bot">
      <p class="label">&copy; {year} {site.name}</p>
      <p class="label">{dict.lines.join(' · ')}</p>
    </div>
  </div>
</footer>

<style>
  .ft { padding-block: clamp(3.5rem, 8vh, 6rem) 2rem; }

  .ft__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vh, 4rem);
    border-bottom: 1px solid var(--line-on-ink);
  }

  .ft__brand { display: flex; flex-direction: column; align-items: flex-start; gap: 1.35rem; }
  .ft__seal { width: 76px; height: 76px; border-radius: 50%; }
  /* The wordmark is another component's element and carries that component's
     scope, so a plain `.ft__mark` here never matched it — the size and the
     alignment below had been doing nothing at all. */
  :global(.ft__mark) { --wm-size: clamp(1rem, 1.6vw, 1.2rem); --wm-sub: var(--gold-lit); align-items: flex-start; }
  .ft__tag {
    font-family: var(--serif);
    font-style: italic;
    /* neither RTL display face has an italic — do not request one */
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--on-ink-muted);
  }
  :global([dir='rtl']) .ft__tag { font-style: normal; }

  .ft__addr {
    display: flex;
    flex-direction: column;
    gap: .2rem;
    font-size: var(--t-small);
    color: var(--on-ink-muted);
    transition: color .4s var(--ease);
  }
  @media (hover: hover) { .ft__addr:hover { color: var(--on-ink); } }
  .ft__addr-local { font-size: .8125rem; text-align: start; }

  .ft__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .ft__col ul { list-style: none; margin: 1.35rem 0 0; padding: 0; }
  /* the gap between rows is now mostly the links' own tap area, so the list
     reads at the same rhythm while each row clears a fingertip */
  .ft__col li + li { margin-top: .1rem; }
  /* A contact row carries its name above the number, so it needs a little more
     air than a plain link and the name has to sit quieter than the value. */
  .ft__ch + .ft__ch { margin-top: .55rem; }
  .ft__chName {
    display: block;
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    opacity: .5;
    margin-bottom: .05rem;
  }

  .ft__col a {
    display: inline-block;
    padding-block: .45rem;
    font-size: var(--t-small);
    color: var(--on-ink);
    position: relative;
  }
  .ft__col a::after {
    content: '';
    position: absolute;
    /* just under the word, inside the padding that makes the tap area */
    inset-inline: 0; bottom: .3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: var(--origin-end);
    transition: transform .45s var(--ease);
  }
  @media (hover: hover) { .ft__col a:hover::after { transform: scaleX(1); transform-origin: var(--origin-start); } }

  .ft__bot {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 2rem;
    justify-content: space-between;
    padding-top: 1.75rem;
  }

  @media (max-width: 860px) {
    .ft__top { grid-template-columns: 1fr; }
    .ft__cols { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 2.25rem; }
  }

  /* On a phone this ran to nine hundred and seventy-eight pixels — longer than
     the screen it sits at the bottom of, and a third of the whole contact page.
     A footer is a place to leave from, not a page of its own, so every part of
     it is drawn in: the seal is a mark rather than a medallion, the stacks lose
     the air they were given for a wide screen, and the columns sit three
     abreast where three short words fit. Nothing is removed — an address, a
     line and a way to reach the atelier are why anyone scrolls this far. */
  @media (max-width: 640px) {
    .ft { padding-block: 1.9rem 1.2rem; }
    .ft__top { gap: 1.3rem; padding-bottom: 1.3rem; }

    /* The seal stood above the name with the whole width of the screen empty
       beside it. On a phone the two sit together as one lockup, and the line
       and the address run under them. */
    .ft__brand {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: .85rem;
      row-gap: .6rem;
      align-items: center;
    }
    .ft__seal { width: 50px; height: 50px; grid-row: 1; }
    :global(.ft__mark) { grid-column: 2; grid-row: 1; }
    .ft__tag, .ft__addr { grid-column: 1 / -1; }
    /* A grid cell stretches its item, which centred the name and threw the
       Hebrew address to the far edge — a right-to-left line in a stretched box
       aligns to its own start. Each sits at the column's start instead. */
    :global(.ft__mark), .ft__tag, .ft__addr { justify-self: start; }
    .ft__tag { margin: 0; }

    .ft__cols { gap: 1.15rem 1.25rem; }
    .ft__col ul { margin-top: .7rem; }
    /* The body's line height is set for reading paragraphs; a column of
       single words spaced that far apart is most of why this footer ran long.
       The rows still clear the 24px a fingertip needs. */
    .ft__col a { padding-block: .4rem; font-size: .8125rem; line-height: 1.3; }
    .ft__col li + li { margin-top: .15rem; }
    .ft__col h2 { line-height: 1.3; }
    .ft__col a::after { bottom: .2rem; }
    .ft__ch + .ft__ch { margin-top: .3rem; }
    .ft__chName { margin-bottom: 0; }

    .ft__bot { padding-top: .9rem; gap: .35rem 1.25rem; }
  }
  /* A phone is too narrow for three columns without breaking a telephone
     number across lines, so the two lists of links sit side by side and the
     ways of reaching the atelier run underneath them — in two columns of their
     own, which is a row and a half rather than a stack of six lines. */
  @media (max-width: 640px) {
    .ft__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ft__cols > :last-child { grid-column: 1 / -1; }
    .ft__cols > :last-child ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .4rem 1.25rem;
    }
    .ft__ch + .ft__ch { margin-top: 0; }
    /* an address is long and a column is narrow: it wraps rather than spills */
    .ft__col a { overflow-wrap: anywhere; }
  }
</style>
