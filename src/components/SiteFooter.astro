---
import Wordmark from './Wordmark.astro';
import { nav, site, contactChannels, location, mapsUrl } from '~/config/site';
import { collections } from '~/data/collections';

const channels = contactChannels();
const year = new Date().getFullYear();
---

<footer class="ft ink">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <img class="ft__seal" src="/brand/seal.webp" width="96" height="96" alt="" loading="lazy" decoding="async" />
        <Wordmark href={null} class="ft__mark" />
        <p class="ft__tag">{site.tagline}</p>
        <a class="ft__addr" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          <span>{location.street}, {location.city}</span>
          <span class="ft__addr-local" lang={location.localLang} dir="rtl">{location.streetLocal}, {location.cityLocal}</span>
        </a>
      </div>

      <nav class="ft__cols" aria-label="Footer">
        <div class="ft__col">
          <h2 class="label">Collections</h2>
          <ul>
            {collections.map((c) => <li><a href={`/collections/${c.slug}`}>{c.name}</a></li>)}
          </ul>
        </div>
        <div class="ft__col">
          <h2 class="label">Atelier</h2>
          <ul>
            {nav.filter((n) => n.href !== '/collections').map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div class="ft__col">
          <h2 class="label">Enquiries</h2>
          <ul>
            {channels.map((ch) => (
              <li>
                <a
                  href={ch.href}
                  {...ch.id === 'instagram' || ch.id === 'whatsapp'
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {}}
                >{ch.value}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <div class="ft__bot">
      <p class="label">&copy; {year} {site.name}</p>
      <p class="label">{site.lines.join(' · ')}</p>
    </div>
  </div>
</footer>

<style>
  .ft { padding-block: clamp(3.5rem, 8vh, 6rem) 2rem; }

  .ft__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vh, 4rem);
    border-bottom: 1px solid var(--line-on-ink);
  }

  .ft__brand { display: flex; flex-direction: column; align-items: flex-start; gap: 1.35rem; }
  .ft__seal { width: 76px; height: 76px; border-radius: 50%; }
  .ft__mark { --wm-size: clamp(1rem, 1.6vw, 1.2rem); --wm-sub: var(--gold-lit); align-items: flex-start; }
  .ft__tag {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--on-ink-muted);
  }

  .ft__addr {
    display: flex;
    flex-direction: column;
    gap: .2rem;
    font-size: var(--t-small);
    color: var(--on-ink-muted);
    transition: color .4s var(--ease);
  }
  .ft__addr:hover { color: var(--on-ink); }
  .ft__addr-local { font-size: .8125rem; text-align: left; }

  .ft__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .ft__col ul { list-style: none; margin: 1.35rem 0 0; padding: 0; }
  .ft__col li + li { margin-top: .6rem; }
  .ft__col a {
    font-size: var(--t-small);
    color: var(--on-ink);
    position: relative;
  }
  .ft__col a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .45s var(--ease);
  }
  .ft__col a:hover::after { transform: scaleX(1); transform-origin: left; }

  .ft__bot {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 2rem;
    justify-content: space-between;
    padding-top: 1.75rem;
  }

  @media (max-width: 860px) {
    .ft__top { grid-template-columns: 1fr; }
    .ft__addr {
    display: flex;
    flex-direction: column;
    gap: .2rem;
    font-size: var(--t-small);
    color: var(--on-ink-muted);
    transition: color .4s var(--ease);
  }
  .ft__addr:hover { color: var(--on-ink); }
  .ft__addr-local { font-size: .8125rem; text-align: left; }

  .ft__cols { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 2.25rem; }
  }
</style>
