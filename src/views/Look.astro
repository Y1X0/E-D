---
import Base from '~/layouts/Base.astro';
import Plate from '~/components/Plate.astro';
import LookCard from '~/components/LookCard.astro';
import Lightbox from '~/components/Lightbox.astro';
import { relatedLooks, type LookShape } from '~/data/looks';
import { site } from '~/config/site';
import { t, localePath, type Locale } from '~/i18n';

interface Props { locale: Locale; look: LookShape }
const { locale, look } = Astro.props;
const dict = t(locale);
const copy = dict.collections[look.collection];
const title = dict.ui.lookTitle(look.index);
const note = dict.lookNotes[look.collection][look.index - 1];
const related = relatedLooks(look, 3);
const path = `/looks/${look.slug}`;

const schema = {
  '@type': 'CreativeWork',
  name: `${title} — ${copy.name}`,
  url: new URL(localePath(path, locale), site.url).href,
  description: note,
  creator: { '@id': `${site.url}/#organization` },
  inLanguage: locale,
  isPartOf: {
    '@type': 'CollectionPage',
    name: copy.name,
    url: new URL(localePath(`/collections/${look.collection}`, locale), site.url).href,
  },
};
---

<Base
  locale={locale}
  path={path}
  title={`${title} — ${copy.name}`}
  description={dict.seoLook(title, copy.name, note)}
  type="article"
  schema={schema}
>
  <div class="look">
    <nav class="wrap look__crumb" aria-label={dict.ui.breadcrumb}>
      <ol>
        <li><a href={localePath('/collections', locale)}>{dict.collectionsPage.eyebrow}</a></li>
        <li aria-hidden="true">&#47;</li>
        <li><a href={localePath(`/collections/${look.collection}`, locale)}>{copy.name}</a></li>
        <li aria-hidden="true">&#47;</li>
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>

    <article class="wrap look__in">
      <div class="look__media">
        {look.plates.map((p, i) => (
          <figure class="look__fig" data-zoom>
            <Plate {...p} sizes="(max-width: 900px) 92vw, 56vw" priority={i === 0} />
          </figure>
        ))}
      </div>

      <div class="look__aside">
        <div class="look__sticky">
          <p class="label eyebrow look__line">{copy.name}</p>
          <h1 class="t-display look__h">{title}</h1>
          <p class="look__note">{note}</p>

          <dl class="look__spec">
            <div>
              <dt class="label">{dict.lookPage.line}</dt>
              <dd>{copy.name}</dd>
            </div>
            <div>
              <dt class="label">{dict.lookPage.made}</dt>
              <dd>{dict.lookPage.madeValue}</dd>
            </div>
            <div>
              <dt class="label">{dict.lookPage.fabrics}</dt>
              <dd>{dict.lookPage.fabricsValue}</dd>
            </div>
          </dl>

          <div class="look__acts">
            <a class="cta cta--solid" href={`${localePath('/contact', locale)}?enquiry=${encodeURIComponent(copy.name)}`}>
              {dict.lookPage.enquire} <span class="arw" aria-hidden="true">&#8594;</span>
            </a>
            <a class="link" href={localePath(`/collections/${look.collection}`, locale)}>
              {dict.ui.backTo(copy.name)} <span class="arw" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>
      </div>
    </article>

    <section class="section related" aria-labelledby="rel-h">
      <div class="wrap">
        <div class="related__head reveal">
          <h2 class="t-h2" id="rel-h">{dict.lookPage.related}</h2>
          <a class="link" href={localePath('/gallery', locale)}>
            {dict.ui.viewAll} <span class="arw" aria-hidden="true">&#8594;</span>
          </a>
        </div>
        <div class="related__grid">
          {related.map((l, i) => <LookCard locale={locale} look={l} delay={i * 90} />)}
        </div>
      </div>
    </section>
  </div>

  <Lightbox locale={locale} />
</Base>

<style>
  .look__crumb { padding-top: calc(var(--header-h) + clamp(1.5rem, 5vh, 3rem)); }
  .look__crumb ol {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    list-style: none; margin: 0; padding: 0;
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .look__crumb a:hover { color: var(--gold-ink); }
  .look__crumb [aria-current='page'] { color: var(--ink); }

  .look__in {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-top: clamp(2rem, 5vh, 3.5rem);
    align-items: start;
  }
  .look__media { display: flex; flex-direction: column; gap: clamp(1rem, 2.5vw, 2rem); }
  .look__fig { margin: 0; }

  .look__sticky { position: sticky; top: calc(var(--header-h) + 2rem); display: flex; flex-direction: column; align-items: flex-start; gap: 1.15rem; }
  .look__line { margin: 0; color: var(--gold-ink); }
  .look__h { margin: 0; }
  .look__note { color: var(--ink-muted); max-width: 34ch; font-size: var(--t-lead); line-height: 1.6; }

  .look__spec { margin: 1rem 0 0; width: 100%; border-top: 1px solid var(--line); }
  .look__spec > div { padding-block: .95rem; border-bottom: 1px solid var(--line); }
  .look__spec dt { margin-bottom: .4rem; }
  .look__spec dd { margin: 0; font-size: var(--t-small); color: var(--ink-muted); }

  .look__acts { display: flex; flex-direction: column; align-items: flex-start; gap: 1.4rem; margin-top: 1rem; }

  .related__head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .related__head h2 { margin: 0; }
  .related__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 3.5vw, 3rem); }

  @media (max-width: 900px) {
    .look__in { grid-template-columns: 1fr; }
    .look__sticky { position: static; }
    .related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) { .related__grid { grid-template-columns: 1fr; gap: 2.75rem; } }
</style>
