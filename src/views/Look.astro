---
import Base from '~/layouts/Base.astro';
import Plate from '~/components/Plate.astro';
import LookCard from '~/components/LookCard.astro';
import Lightbox from '~/components/Lightbox.astro';
import { getContent, relatedTo } from '~/content';
import { formatPrice } from '~/lib/price';
import { checkoutUrl } from '~/lib/pay';
import { site } from '~/config/site';
import { t, localePath, type Locale } from '~/i18n';

interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const dict = t(locale);
const { collections, looks, settings } = await getContent(locale);
const look = looks.find((l) => l.slug === slug)!;
const copy = collections.find((c) => c.slug === look.collection)!;
const title = dict.ui.lookTitle(look.index);
const note = look.note;
const related = relatedTo(look, looks, 3);
const nameOf = (s: string) => collections.find((c) => c.slug === s)?.name ?? s;
const path = `/looks/${slug}`;

// A piece is bought rather than commissioned only when it carries a price. The
// checkout page is the atelier's own; without one the order goes to WhatsApp,
// which is where it would have been placed anyway.
const whatsapp = settings?.whatsapp ?? site.contact.whatsapp;
const price = look.price ? formatPrice(look.price) : null;
// A hire is a conversation, not a checkout: the dates, the fitting and the
// deposit are settled with the atelier before the dress leaves the room.
const hire = look.hire ? formatPrice(look.hire) : null;
const hireHref = hire && whatsapp
  ? `https://wa.me/${whatsapp}?text=${encodeURIComponent(dict.lookPage.hireMessage(title, copy.name, hire))}`
  : '';
const checkout = look.price
  ? checkoutUrl(settings, {
      item: `${site.name} — ${copy.name} · ${title}`,
      amount: look.price,
      returnTo: new URL(localePath(path, locale), site.url).href,
      locale,
    }, look.payUrl)
  : null;
// Three ways to buy, in the order they are trusted. Our own checkout, which
// prices the order server-side and only calls it paid once the gateway's
// webhook says so. A hosted payment link, when the atelier has one but no
// service. And WhatsApp, which is where the order would have gone anyway.
const ownCheckout = price && site.paymentApi ? localePath(`/checkout/${slug}`, locale) : '';
const orderHref = ownCheckout
  || checkout
  || (whatsapp
    ? `https://wa.me/${whatsapp}?text=${encodeURIComponent(dict.lookPage.orderMessage(title, copy.name, price ?? ''))}`
    : '');

const schema = {
  '@type': 'CreativeWork',
  name: `${title} — ${copy.name}`,
  url: new URL(localePath(path, locale), site.url).href,
  description: note,
  creator: { '@id': `${site.url}/#organization` },
  inLanguage: locale,
  isPartOf: {
    '@type': 'CollectionPage',
    name: copy.name,
    url: new URL(localePath(`/collections/${look.collection}`, locale), site.url).href,
  },
};
---

<Base
  locale={locale}
  path={path}
  title={`${title} — ${copy.name}`}
  description={dict.seoLook(title, copy.name, note)}
  type="article"
  schema={schema}
>
  <div class="look">
    <nav class="wrap look__crumb" aria-label={dict.ui.breadcrumb}>
      <ol>
        <li><a href={localePath('/collections', locale)}>{dict.collectionsPage.eyebrow}</a></li>
        <li aria-hidden="true">&#47;</li>
        <li><a href={localePath(`/collections/${look.collection}`, locale)}>{copy.name}</a></li>
        <li aria-hidden="true">&#47;</li>
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>

    <article class="wrap look__in">
      <div class="look__media">
        {look.plates.map((p, i) => (
          <figure class="look__fig" data-zoom>
            <Plate {...p} sizes="(max-width: 900px) 92vw, 56vw" priority={i === 0} />
          </figure>
        ))}
      </div>

      <div class="look__aside">
        <div class="look__sticky">
          <p class="label eyebrow look__line">{copy.name}</p>
          <h1 class="t-display look__h">{title}</h1>
          <p class="look__note">{note}</p>

          {price && <p class="look__price">{price}</p>}
          {hire && (
            <p class="look__hire">
              <span class="label">{dict.lookPage.hire}</span> {hire}
            </p>
          )}

          <dl class="look__spec">
            <div>
              <dt class="label">{dict.lookPage.line}</dt>
              <dd>{copy.name}</dd>
            </div>
            <div>
              <dt class="label">{dict.lookPage.made}</dt>
              <dd>{dict.lookPage.madeValue}</dd>
            </div>
            <div>
              <dt class="label">{dict.lookPage.fabrics}</dt>
              <dd>{dict.lookPage.fabricsValue}</dd>
            </div>
            <div>
              <dt class="label">{dict.lookPage.price}</dt>
              <dd>{price ?? dict.lookPage.madeToMeasure}</dd>
            </div>
            {hire && (
              <div>
                <dt class="label">{dict.lookPage.hire}</dt>
                <dd>{hire}</dd>
              </div>
            )}
          </dl>

          <div class="look__acts">
            {price && orderHref && (
              <a class="cta cta--solid" href={orderHref} rel={ownCheckout ? undefined : checkout ? 'noopener' : 'noopener nofollow'}>
                {ownCheckout || checkout ? dict.lookPage.buy : dict.lookPage.orderOnWhatsapp}
                <span class="arw" aria-hidden="true">&#8594;</span>
              </a>
            )}
            {price && (ownCheckout || checkout) && (ownCheckout || settings?.payMethods) && (
              <p class="look__pay">{dict.lookPage.payNote} <span>{settings?.payMethods || dict.checkout.cards}</span></p>
            )}
            {hire && hireHref && (
              <a class:list={['cta', !(price && orderHref) && 'cta--solid']} href={hireHref} rel="noopener nofollow">
                {dict.lookPage.hireCta} <span class="arw" aria-hidden="true">&#8594;</span>
              </a>
            )}
            {hire && <p class="look__pay">{dict.lookPage.hireNote}</p>}
            <a class:list={['cta', !(price && orderHref) && !hire && 'cta--solid']} href={`${localePath('/contact', locale)}?enquiry=${encodeURIComponent(copy.name)}`}>
              {dict.lookPage.enquire} <span class="arw" aria-hidden="true">&#8594;</span>
            </a>
            <a class="link" href={localePath(`/collections/${look.collection}`, locale)}>
              {dict.ui.backTo(copy.name)} <span class="arw" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>
      </div>
    </article>

    <section class="section related" aria-labelledby="rel-h">
      <div class="wrap">
        <div class="related__head reveal">
          <h2 class="t-h2" id="rel-h">{dict.lookPage.related}</h2>
          <a class="link" href={localePath('/gallery', locale)}>
            {dict.ui.viewAll} <span class="arw" aria-hidden="true">&#8594;</span>
          </a>
        </div>
        <div class="related__grid reveal">
          {related.map((l) => <LookCard locale={locale} look={l} collectionName={nameOf(l.collection)} />)}
        </div>
      </div>
    </section>
  </div>

  <Lightbox locale={locale} />
</Base>

<style>
  .look__price {
    font-size: var(--t-h3);
    letter-spacing: .01em;
    color: var(--gold-ink);
    margin: .75rem 0 0;
  }
  .look__hire {
    margin: 0;
    font-size: var(--t-lead);
    color: var(--ink);
  }
  .look__hire .label { color: var(--gold-ink); margin-inline-end: .5rem; }

  .look__pay {
    font-size: var(--t-small);
    color: var(--ink-muted);
    margin: .75rem 0 0;
  }
  .look__pay span { display: block; letter-spacing: var(--track-label); }

  .look__crumb { padding-top: calc(var(--header-h) + clamp(1.5rem, 5vh, 3rem)); }
  .look__crumb ol {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    list-style: none; margin: 0; padding: 0;
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .look__crumb a:hover { color: var(--gold-ink); }
  .look__crumb [aria-current='page'] { color: var(--ink); }

  .look__in {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-top: clamp(2rem, 5vh, 3.5rem);
    align-items: start;
  }
  .look__media { display: flex; flex-direction: column; gap: clamp(1rem, 2.5vw, 2rem); }
  .look__fig { margin: 0; }

  .look__sticky { position: sticky; top: calc(var(--header-h) + 2rem); display: flex; flex-direction: column; align-items: flex-start; gap: 1.15rem; }
  .look__line { margin: 0; color: var(--gold-ink); }
  .look__h { margin: 0; }
  .look__note { color: var(--ink-muted); max-width: 34ch; font-size: var(--t-lead); line-height: 1.6; }

  .look__spec { margin: 1rem 0 0; width: 100%; border-top: 1px solid var(--line); }
  .look__spec > div { padding-block: .95rem; border-bottom: 1px solid var(--line); }
  .look__spec dt { margin-bottom: .4rem; }
  .look__spec dd { margin: 0; font-size: var(--t-small); color: var(--ink-muted); }

  .look__acts { display: flex; flex-direction: column; align-items: flex-start; gap: 1.4rem; margin-top: 1rem; }

  .related__head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .related__head h2 { margin: 0; }
  .related__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 3.5vw, 3rem); }

  @media (max-width: 900px) {
    .look__in { grid-template-columns: 1fr; }
    .look__sticky { position: static; }
    .related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) { .related__grid { grid-template-columns: 1fr; gap: 2.75rem; } }
</style>
