---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Plate from '~/components/Plate.astro';
import SectionHead from '~/components/SectionHead.astro';
import LookCard from '~/components/LookCard.astro';
import InstagramPanel from '~/components/InstagramPanel.astro';
import { collections } from '~/data/collections';
import { looks } from '~/data/looks';
import { site } from '~/config/site';
import { t, localePath, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const h = dict.home;

const featured = [looks[0], looks[4], looks[8]];

const schema = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  description: dict.tagline,
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: locale,
};
---

<Base
  locale={locale}
  path="/"
  title={dict.seo.home.title}
  titleExact
  description={dict.seo.home.description}
  variant="over"
  schema={schema}
>
  <Hero locale={locale} />

  <!-- ——— opening statement ——— -->
  <section class="section opening" id="opening" aria-labelledby="opening-h">
    <div class="wrap opening__in">
      <p class="label eyebrow reveal">{h.openingEyebrow}</p>
      <h2 class="t-display opening__h reveal" id="opening-h" style="--reveal-delay:60ms">
        {h.openingTitle} <span class="t-italic opening__accent">{h.openingAccent}</span>
      </h2>
      <div class="opening__body reveal" style="--reveal-delay:120ms">
        {h.openingBody.map((p) => <p>{p}</p>)}
        <a class="link opening__link" href={localePath('/about', locale)}>
          {dict.ui.aboutAtelier} <span class="arw" aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ——— the three lines ——— -->
  <section class="section section--tight lines" aria-labelledby="lines-h">
    <div class="wrap">
      <SectionHead
        eyebrow={h.linesEyebrow}
        title={h.linesTitle}
        accent={h.linesAccent}
        lead={h.linesLead}
        href={localePath('/collections', locale)}
        linkLabel={dict.ui.allCollections}
        id="lines-h"
      />

      <ul class="lines__grid">
        {collections.map((c, i) => (
          <li class="lines__item reveal" style={`--reveal-delay:${i * 90}ms`}>
            <a class="lines__a" href={localePath(`/collections/${c.slug}`, locale)}>
              <Plate {...c.cover} sizes="(max-width: 720px) 88vw, (max-width: 1100px) 44vw, 30vw" class="lines__plate" />
              <div class="lines__meta">
                <h3 class="t-h3 lines__name">{dict.collections[c.slug].name}</h3>
                <p class="lines__kicker">{dict.collections[c.slug].kicker}</p>
                <span class="link lines__cta">
                  {dict.ui.view} <span class="arw" aria-hidden="true">&#8594;</span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ——— selected work ——— -->
  <section class="section selected ink" aria-labelledby="selected-h">
    <div class="wrap">
      <SectionHead
        eyebrow={h.selectedEyebrow}
        title={h.selectedTitle}
        accent={h.selectedAccent}
        lead={h.selectedLead}
        href={localePath('/gallery', locale)}
        linkLabel={dict.ui.openGallery}
        id="selected-h"
      />
      <div class="selected__grid">
        {featured.map((l, i) => <LookCard locale={locale} look={l} delay={i * 100} />)}
      </div>
    </div>
  </section>

  <!-- ——— bespoke ——— -->
  <section class="section bespoke" aria-labelledby="bespoke-h">
    <div class="wrap bespoke__in">
      <div class="bespoke__aside">
        <SectionHead
          eyebrow={h.bespokeEyebrow}
          title={h.bespokeTitle}
          accent={h.bespokeAccent}
          lead={h.bespokeLead}
          href={localePath('/bespoke', locale)}
          linkLabel={dict.ui.fullProcess}
          id="bespoke-h"
        />
      </div>
      <ol class="bespoke__steps">
        {dict.bespoke.steps.map((s, i) => (
          <li class="bespoke__step reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="bespoke__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="bespoke__t">{s.title}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <InstagramPanel locale={locale} />

  <!-- ——— closing invitation ——— -->
  <section class="section closing" aria-labelledby="closing-h">
    <div class="wrap closing__in">
      <p class="label eyebrow reveal">{h.closingEyebrow}</p>
      <h2 class="t-display closing__h reveal" id="closing-h" style="--reveal-delay:60ms">
        {h.closingTitle} <span class="t-italic closing__accent">{h.closingAccent}</span>
      </h2>
      <p class="lead closing__lead reveal" style="--reveal-delay:110ms">{h.closingLead}</p>
      <div class="closing__acts reveal" style="--reveal-delay:160ms">
        <a class="cta cta--solid" href={localePath('/contact', locale)}>
          {dict.booking} <span class="arw" aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* opening */
  .opening__in {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    column-gap: clamp(2.5rem, 7vw, 7rem);
    row-gap: 2rem;
    align-items: start;
  }
  .opening__in > .eyebrow { grid-column: 1; margin: 0; }
  .opening__h { grid-column: 1; margin: 0; }
  .opening__accent { color: var(--gold-ink); }
  .opening__body { grid-column: 2; grid-row: 1 / span 2; max-width: 54ch; padding-top: .6rem; }
  .opening__body p { color: var(--ink-muted); }
  .opening__body p + p { margin-top: 1.1em; }
  .opening__link { margin-top: 1.75rem; }

  /* lines */
  .lines__grid {
    list-style: none;
    margin: clamp(3rem, 7vh, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }
  .lines__item:nth-child(2) { margin-top: clamp(1.5rem, 5vw, 4rem); }
  .lines__item:nth-child(3) { margin-top: clamp(3rem, 10vw, 8rem); }

  .lines__a:hover :global(.lines__plate img) { transform: scale(1.045); }
  .lines__meta { margin-top: 1.35rem; display: flex; flex-direction: column; gap: .55rem; align-items: flex-start; }
  .lines__name { margin: 0; }
  .lines__kicker { color: var(--ink-muted); font-size: var(--t-small); max-width: 30ch; }
  .lines__cta { margin-top: .5rem; color: var(--gold-ink); }

  /* selected */
  .selected__grid {
    margin-top: clamp(3rem, 7vh, 5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  /* bespoke */
  .bespoke__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .bespoke__steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .bespoke__step {
    display: flex;
    align-items: baseline;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: clamp(1.1rem, 2.4vh, 1.6rem);
    border-bottom: 1px solid var(--line);
  }
  .bespoke__n {
    font-family: var(--sans);
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    color: var(--gold-ink);
    flex: none;
  }
  .bespoke__t { font-family: var(--serif); font-weight: 300; font-size: clamp(1.4rem, 2.6vw, 2rem); margin: 0; }

  /* closing */
  .closing__in { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.4rem; }
  .closing__h { margin: 0; max-width: 20ch; }
  .closing__accent { color: var(--gold-ink); }
  .closing__lead { max-width: 54ch; }
  .closing__acts { margin-top: 1rem; }

  @media (max-width: 980px) {
    .opening__in { grid-template-columns: 1fr; }
    .opening__body { grid-column: 1; grid-row: auto; }
    .bespoke__in { grid-template-columns: 1fr; }
    .lines__grid, .selected__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lines__item:nth-child(3) { margin-top: 0; }
  }
  @media (max-width: 640px) {
    .lines__grid, .selected__grid { grid-template-columns: 1fr; gap: 2.75rem; }
    .lines__item:nth-child(n) { margin-top: 0; }
  }
</style>
