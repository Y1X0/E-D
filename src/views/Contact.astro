---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import InquiryForm from '~/components/InquiryForm.astro';
import { site, contactChannels, location, mapsUrl } from '~/config/site';
import { t, localePath, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.contact;

const noteKey = { whatsapp: 'noteWhatsapp', instagram: 'noteInstagram', phone: 'notePhone', email: 'noteEmail' } as const;
const channels = contactChannels().map((ch) => ({
  ...ch,
  note: c[noteKey[ch.id as keyof typeof noteKey]],
}));

const schema = {
  '@type': 'ContactPage',
  name: `${c.eyebrow} — ${site.name}`,
  url: new URL(localePath('/contact', locale), site.url).href,
  description: dict.seo.contact.description,
  isPartOf: { '@id': `${site.url}/#website` },
  mainEntity: { '@id': `${site.url}/#organization` },
  inLanguage: locale,
};
---

<Base
  locale={locale}
  path="/contact"
  title={dict.seo.contact.title}
  description={dict.seo.contact.description}
  schema={schema}
>
  <PageHero eyebrow={c.eyebrow} title={c.title} accent={c.accent} lead={c.lead} />

  <div class="section contact">
    <div class="wrap contact__in">
      <aside class="contact__aside reveal" aria-labelledby="direct-h">
        <h2 class="label eyebrow" id="direct-h">{c.speakTo}</h2>

        <ul class="channels">
          {channels.map((ch) => (
            <li class="channel">
              <a
                class="channel__a"
                href={ch.href}
                {...ch.id === 'instagram' || ch.id === 'whatsapp'
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {}}
              >
                <span class="label channel__label">{ch.label}</span>
                <span class="channel__value" dir="ltr">{ch.value}</span>
                <span class="channel__note">{ch.note}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="visit">
          <h3 class="label eyebrow">{c.theAtelier}</h3>
          <a class="visit__a" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            <span class="visit__street">{location.street}</span>
            <span class="visit__city">{location.city}, {location.countryName}</span>
            <span class="visit__local" lang={location.localLang} dir="rtl">
              {location.streetLocal}, {location.cityLocal}
            </span>
            <span class="link visit__map">
              {dict.ui.openInMaps} <span class="arw" aria-hidden="true">&#8599;</span>
            </span>
          </a>
          <p class="visit__note">{c.appointments}</p>
        </div>
      </aside>

      <section class="contact__form reveal" style="--reveal-delay:90ms" aria-labelledby="form-h">
        <h2 class="t-h2 contact__h" id="form-h">{c.formTitle}</h2>
        <p class="contact__sub">{c.formSub}</p>
        <InquiryForm locale={locale} />
      </section>
    </div>
  </div>
</Base>

<style>
  .contact__in {
    display: grid;
    grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .contact__aside { display: flex; flex-direction: column; gap: 2.25rem; }

  .channels { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .channel { border-bottom: 1px solid var(--line); }
  .channel__a {
    display: flex;
    flex-direction: column;
    gap: .45rem;
    padding-block: 1.35rem;
    transition: padding-inline-start .5s var(--ease);
  }
  .channel__a:hover { padding-inline-start: .6rem; }
  .channel__label { color: var(--ink-muted); }
  .channel__value {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    font-weight: 300;
    line-height: 1.2;
    text-align: start;
  }
  .channel__a:hover .channel__value { color: var(--gold-ink); }
  .channel__note { font-size: var(--t-small); color: var(--ink-muted); }

  .visit { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  .visit__a { display: flex; flex-direction: column; gap: .35rem; }
  .visit__street { font-family: var(--serif); font-size: clamp(1.3rem, 2.2vw, 1.75rem); font-weight: 300; line-height: 1.2; }
  .visit__a:hover .visit__street { color: var(--gold-ink); }
  .visit__city { font-size: var(--t-small); color: var(--ink-muted); }
  .visit__local { font-size: var(--t-small); color: var(--ink-muted); text-align: start; align-self: stretch; }
  .visit__map { margin-top: .65rem; color: var(--gold-ink); }
  .visit__note { font-size: var(--t-small); color: var(--ink-muted); line-height: 1.7; max-width: 38ch; }

  .contact__h { margin: 0 0 .85rem; }
  .contact__sub { color: var(--ink-muted); max-width: 46ch; margin-bottom: clamp(2rem, 4vh, 2.75rem); }

  @media (max-width: 900px) { .contact__in { grid-template-columns: 1fr; gap: 3.5rem; } }
</style>

<script>
  /* A look page can arrive with ?enquiry=… — preselect that line. */
  function preselect() {
    const wanted = new URLSearchParams(window.location.search).get('enquiry');
    if (!wanted) return;
    const select = document.querySelector<HTMLSelectElement>('#f-type');
    const match = select && Array.from(select.options).find((o) => o.value === wanted);
    if (select && match) select.value = match.value;
  }
  document.addEventListener('astro:page-load', preselect);
</script>
