---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Plate from '~/components/Plate.astro';
import Lightbox from '~/components/Lightbox.astro';
import { getContent, galleryFrom } from '~/content';
import { site } from '~/config/site';
import { t, localePath, type Locale } from '~/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const content = await getContent(locale);
const { collections } = content;
const galleryItems = galleryFrom(content);
const nameOf = (slug: string) => collections.find((c) => c.slug === slug)?.name ?? slug;

const filters = [
  { slug: 'all', name: dict.gallery.all },
  ...collections.map((c) => ({ slug: c.slug, name: c.name })),
];

const schema = {
  '@type': 'ImageGallery',
  name: `${dict.gallery.eyebrow} — ${site.name}`,
  url: new URL(localePath('/gallery', locale), site.url).href,
  description: dict.seo.gallery.description,
  isPartOf: { '@id': `${site.url}/#website` },
  inLanguage: locale,
};
---

<Base
  locale={locale}
  path="/gallery"
  title={dict.seo.gallery.title}
  description={dict.seo.gallery.description}
  schema={schema}
>
  <PageHero
    eyebrow={dict.gallery.eyebrow}
    title={`${dict.gallery.title} ${dict.gallery.accent}`}
    lead={dict.gallery.lead}
  />

  <div class="section gal">
    <div class="wrap">
      <div class="gal__filters" role="group" aria-label={dict.gallery.eyebrow}>
        {filters.map((f, i) => (
          <button class="gal__filter" type="button" data-filter={f.slug} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.name}
          </button>
        ))}
      </div>

      <p class="label gal__count" role="status" aria-live="polite" data-one={dict.ui.imagesCount(1)} data-many={dict.ui.imagesCount(0)}></p>

      <div class="gal__grid" id="gal-grid">
        {galleryItems.map((item, i) => (
          <figure class="gal__item" data-line={item.line} data-zoom>
            <Plate {...item.plate} sizes="(max-width: 720px) 92vw, (max-width: 1100px) 46vw, 31vw" priority={i < 3} />
            <figcaption class="gal__cap">
              <span class="label">{nameOf(item.line)}</span>
              <a class="gal__link" href={localePath(item.href, locale)}>
                {dict.ui.view} <span class="arw" aria-hidden="true">&#8594;</span>
              </a>
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="gal__empty" hidden>{dict.gallery.empty}</p>
    </div>
  </div>

  <Lightbox locale={locale} />
</Base>

<style>
  .gal__filters {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .gal__filter {
    position: relative;
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: .4rem 0;
    transition: color .4s var(--ease);
  }
  [dir='rtl'] .gal__filter { text-transform: none; }
  .gal__filter::after {
    content: '';
    position: absolute; inset-inline: 0; bottom: 0;
    height: 1px; background: var(--gold);
    transform: scaleX(0); transform-origin: var(--origin-end);
    transition: transform .45s var(--ease);
  }
  .gal__filter:hover { color: var(--ink); }
  .gal__filter[aria-pressed='true'] { color: var(--gold-ink); }
  .gal__filter[aria-pressed='true']::after { transform: scaleX(1); transform-origin: var(--origin-start); }

  .gal__count { margin: 1.5rem 0 0; min-height: 1em; }

  .gal__grid {
    margin-top: clamp(2rem, 5vh, 3rem);
    columns: 3;
    column-gap: clamp(1.25rem, 2.6vw, 2.25rem);
  }
  .gal__item {
    break-inside: avoid;
    margin: 0 0 clamp(1.25rem, 2.6vw, 2.25rem);
    display: block;
  }
  .gal__item[hidden] { display: none; }
  .gal__item:hover :global(.plate img) { transform: scale(1.04); }

  .gal__cap { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-top: .8rem; }
  .gal__link {
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold-ink);
    opacity: 0;
    transition: opacity .4s var(--ease);
  }
  [dir='rtl'] .gal__link { text-transform: none; }
  .gal__item:hover .gal__link,
  .gal__link:focus-visible { opacity: 1; }

  .gal__empty { margin-top: 3rem; color: var(--ink-muted); }
  .gal__empty[hidden] { display: none; }

  @media (max-width: 1100px) { .gal__grid { columns: 2; } }
  @media (max-width: 620px)  { .gal__grid { columns: 1; } }
  @media (hover: none) { .gal__link { opacity: 1; } }
</style>

<script>
  import { onReady } from '~/scripts/ready';

  function initGallery() {
    const grid = document.getElementById('gal-grid');
    if (!grid || grid.dataset.bound === 'true') return;
    grid.dataset.bound = 'true';

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.gal__filter'));
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.gal__item'));
    const count = document.querySelector<HTMLElement>('.gal__count')!;
    const empty = document.querySelector<HTMLElement>('.gal__empty')!;

    const apply = (line: string) => {
      let shown = 0;
      for (const el of items) {
        const match = line === 'all' || el.dataset.line === line;
        el.hidden = !match;
        if (match) shown++;
      }
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === line)));
      // the label pattern comes from the page, so the count reads naturally
      const tpl = shown === 1 ? count.dataset.one! : count.dataset.many!;
      count.textContent = tpl.replace(/\d+/, String(shown));
      empty.hidden = shown > 0;
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
    apply('all');
  }

  onReady(initGallery);
</script>
