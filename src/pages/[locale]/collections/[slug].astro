---
import Collection from '~/views/Collection.astro';
import { getRoutes } from '~/content';
import { PREFIXED_LOCALES, type Locale } from '~/i18n';

export async function getStaticPaths() {
  const { collections } = await getRoutes();
  return PREFIXED_LOCALES.flatMap((locale) =>
    collections.map((c) => ({ params: { locale, slug: c.slug } })));
}
---
<Collection locale={Astro.params.locale as Locale} slug={Astro.params.slug!} />
