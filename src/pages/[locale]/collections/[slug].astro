---
import Collection from '~/views/Collection.astro';
import { collections } from '~/data/collections';
import { PREFIXED_LOCALES, type Locale } from '~/i18n';

export const getStaticPaths = () =>
  PREFIXED_LOCALES.flatMap((locale) =>
    collections.map((collection) => ({ params: { locale, slug: collection.slug }, props: { collection } })),
  );

const locale = Astro.params.locale as Locale;
const { collection } = Astro.props;
---
<Collection locale={locale} collection={collection} />
