---
import PaymentResult from '~/views/PaymentResult.astro';
import { PREFIXED_LOCALES, type Locale } from '~/i18n';

export async function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale } }));
}
---
<PaymentResult locale={Astro.params.locale as Locale} kind="success" />
