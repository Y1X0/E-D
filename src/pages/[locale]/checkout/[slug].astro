---
import Checkout from '~/views/Checkout.astro';
import { getRoutes } from '~/content';
import { PREFIXED_LOCALES, type Locale } from '~/i18n';

export async function getStaticPaths() {
  const { looks } = await getRoutes();
  return PREFIXED_LOCALES.flatMap((locale) =>
    looks.filter((l) => l.price).map((l) => ({ params: { locale, slug: l.slug } })));
}
---
<Checkout locale={Astro.params.locale as Locale} slug={Astro.params.slug!} />
