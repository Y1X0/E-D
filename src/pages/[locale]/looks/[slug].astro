---
import Look from '~/views/Look.astro';
import { looks } from '~/data/looks';
import { PREFIXED_LOCALES, type Locale } from '~/i18n';

export const getStaticPaths = () =>
  PREFIXED_LOCALES.flatMap((locale) =>
    looks.map((look) => ({ params: { locale, slug: look.slug }, props: { look } })),
  );

const locale = Astro.params.locale as Locale;
const { look } = Astro.props;
---
<Look locale={locale} look={look} />
