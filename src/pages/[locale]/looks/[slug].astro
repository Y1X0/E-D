---
import Look from '~/views/Look.astro';
import { getRoutes } from '~/content';
import { PREFIXED_LOCALES, type Locale } from '~/i18n';

export async function getStaticPaths() {
  const { looks } = await getRoutes();
  return PREFIXED_LOCALES.flatMap((locale) =>
    looks.map((l) => ({ params: { locale, slug: l.slug } })));
}
---
<Look locale={Astro.params.locale as Locale} slug={Astro.params.slug!} />
