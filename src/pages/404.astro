---
import Base from '~/layouts/Base.astro';
import { site } from '~/config/site';
---

<Base
  title="Page not found"
  description="That page is no longer here."
  noindex
>
  <section class="nf">
    <div class="wrap nf__in">
      <p class="label eyebrow">Error 404</p>
      <h1 class="t-display nf__h">This page has <span class="t-italic nf__accent">left the atelier</span></h1>
      <p class="lead nf__lead">
        The address may have changed, or the piece may have moved. The collections are a good
        place to pick the thread back up.
      </p>
      <div class="nf__acts">
        <a class="cta cta--solid" href="/">Return home <span class="arw" aria-hidden="true">&#8594;</span></a>
        <a class="cta" href="/collections">View collections</a>
      </div>
      <a class="link nf__ig" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
        @{site.instagram.handle} <span class="arw" aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 78svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + 4rem) var(--section);
  }
  .nf__in { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  .nf__h { margin: 0; max-width: 16ch; }
  .nf__accent { color: var(--gold-ink); }
  .nf__lead { max-width: 46ch; }
  .nf__acts { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .75rem; }
  .nf__ig { margin-top: 1.25rem; color: var(--ink-muted); }
</style>
