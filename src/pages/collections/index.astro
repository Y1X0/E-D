---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Plate from '~/components/Plate.astro';
import { collections } from '~/data/collections';
import { looksIn } from '~/data/looks';
import { site } from '~/config/site';

const schema = {
  '@type': 'CollectionPage',
  name: 'Collections',
  url: `${site.url}/collections`,
  description: 'Bridal, evening and couture lines by Elite Evening Design.',
  isPartOf: { '@id': `${site.url}/#website` },
  hasPart: collections.map((c) => ({
    '@type': 'CreativeWork',
    name: c.name,
    url: `${site.url}/collections/${c.slug}`,
    description: c.summary,
  })),
};
---

<Base
  title="Collections"
  description="Bridal, evening and couture — three made-to-measure lines from the Elite Evening Design atelier."
  schema={schema}
>
  <PageHero
    eyebrow="The collections"
    title="Three lines,"
    accent="one standard"
    lead="Each line answers a different occasion. All of them are cut to measure, fitted in person and finished by hand."
  />

  <div class="section coll">
    <div class="wrap">
      {collections.map((c, i) => (
        <article class="coll__row reveal" data-flip={i % 2 === 1 ? 'true' : 'false'}>
          <a class="coll__media" href={`/collections/${c.slug}`} tabindex="-1" aria-hidden="true">
            <Plate {...c.cover} sizes="(max-width: 900px) 90vw, 50vw" class="coll__plate" />
          </a>
          <div class="coll__body">
            <p class="label label--gold coll__idx">{String(i + 1).padStart(2, '0')} &mdash; {c.name}</p>
            <h2 class="t-h2 coll__name">
              <a href={`/collections/${c.slug}`}>{c.name}</a>
            </h2>
            <p class="coll__kicker t-italic">{c.kicker}</p>
            <p class="coll__summary">{c.summary}</p>
            <p class="label coll__count">{looksIn(c.slug).length} looks</p>
            <a class="link coll__link" href={`/collections/${c.slug}`}>
              Enter the collection <span class="arw" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .coll__row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
  }
  .coll__row + .coll__row { margin-top: clamp(4rem, 11vh, 8rem); }
  .coll__row[data-flip='true'] .coll__media { order: 2; }

  .coll__media { display: block; }
  .coll__media:hover :global(.coll__plate img) { transform: scale(1.04); }

  .coll__body { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  .coll__idx { margin: 0; }
  .coll__name { margin: 0; }
  .coll__name a { position: relative; }
  .coll__name a::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: .08em;
    height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: right;
    transition: transform .5s var(--ease);
  }
  .coll__name a:hover::after { transform: scaleX(1); transform-origin: left; }
  .coll__kicker { font-family: var(--serif); font-size: var(--t-lead); color: var(--gold-ink); }
  .coll__summary { color: var(--ink-muted); max-width: 42ch; }
  .coll__count { margin-top: .25rem; }
  .coll__link { margin-top: .75rem; }

  @media (max-width: 900px) {
    .coll__row { grid-template-columns: 1fr; gap: 1.75rem; }
    .coll__row[data-flip='true'] .coll__media { order: 0; }
  }
</style>
