---
import Base from '~/layouts/Base.astro';
import Plate from '~/components/Plate.astro';
import LookCard from '~/components/LookCard.astro';
import Lightbox from '~/components/Lightbox.astro';
import { looks, lookTitle, relatedLooks } from '~/data/looks';
import { collections, collectionBySlug } from '~/data/collections';
import { site } from '~/config/site';

export function getStaticPaths() {
  return looks.map((look) => ({ params: { slug: look.slug }, props: { look } }));
}

const { look } = Astro.props;
const collection = collectionBySlug(look.collection)!;
const title = lookTitle(look);
const related = relatedLooks(look, 3);
const nameOf = (slug: string) => collections.find((c) => c.slug === slug)!.name;

const schema = {
  '@type': 'CreativeWork',
  name: `${title} — ${collection.name}`,
  url: `${site.url}/looks/${look.slug}`,
  description: look.note,
  creator: { '@id': `${site.url}/#organization` },
  isPartOf: { '@type': 'CollectionPage', name: collection.name, url: `${site.url}/collections/${collection.slug}` },
};
---

<Base
  title={`${title} — ${collection.name}`}
  description={`${look.note} ${title} from the ${collection.name} line by ${site.name}.`}
  type="article"
  schema={schema}
>
  <div class="look">
    <!-- ——— breadcrumb ——— -->
    <nav class="wrap look__crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/collections">Collections</a></li>
        <li aria-hidden="true">&#47;</li>
        <li><a href={`/collections/${collection.slug}`}>{collection.name}</a></li>
        <li aria-hidden="true">&#47;</li>
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>

    <!-- ——— the piece ——— -->
    <article class="wrap look__in">
      <div class="look__media">
        {look.plates.map((p, i) => (
          <figure class="look__fig" data-zoom>
            <Plate
              {...p}
              sizes="(max-width: 900px) 92vw, 56vw"
              priority={i === 0}
            />
          </figure>
        ))}
      </div>

      <div class="look__aside">
        <div class="look__sticky">
          <p class="label eyebrow look__line">{collection.name}</p>
          <h1 class="t-display look__h">{title}</h1>
          <p class="look__note">{look.note}</p>

          <dl class="look__spec">
            <div>
              <dt class="label">Line</dt>
              <dd>{collection.name}</dd>
            </div>
            <div>
              <dt class="label">Made</dt>
              <dd>To measure, in the atelier</dd>
            </div>
            <div>
              <dt class="label">Fabrics &amp; finish</dt>
              <dd>Chosen with you at consultation</dd>
            </div>
          </dl>

          <div class="look__acts">
            <a class="cta cta--solid" href={`/contact?enquiry=${encodeURIComponent(collection.name)}`}>
              Enquire about this look <span class="arw" aria-hidden="true">&#8594;</span>
            </a>
            <a class="link" href={`/collections/${collection.slug}`}>
              Back to {collection.name} <span class="arw" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </div>
      </div>
    </article>

    <!-- ——— related ——— -->
    <section class="section related" aria-labelledby="rel-h">
      <div class="wrap">
        <div class="related__head reveal">
          <h2 class="t-h2" id="rel-h">You may also like</h2>
          <a class="link" href="/gallery">All work <span class="arw" aria-hidden="true">&#8594;</span></a>
        </div>
        <div class="related__grid">
          {related.map((l, i) => (
            <LookCard look={l} collectionName={nameOf(l.collection)} delay={i * 90} />
          ))}
        </div>
      </div>
    </section>
  </div>

  <Lightbox />
</Base>

<style>
  .look__crumb { padding-top: calc(var(--header-h) + clamp(1.5rem, 5vh, 3rem)); }
  .look__crumb ol {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    list-style: none; margin: 0; padding: 0;
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .look__crumb a:hover { color: var(--gold-ink); }
  .look__crumb [aria-current='page'] { color: var(--ink); }

  .look__in {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-top: clamp(2rem, 5vh, 3.5rem);
    align-items: start;
  }
  .look__media { display: flex; flex-direction: column; gap: clamp(1rem, 2.5vw, 2rem); }
  .look__fig { margin: 0; }

  .look__sticky { position: sticky; top: calc(var(--header-h) + 2rem); display: flex; flex-direction: column; align-items: flex-start; gap: 1.15rem; }
  .look__line { margin: 0; color: var(--gold-ink); }
  .look__h { margin: 0; }
  .look__note { color: var(--ink-muted); max-width: 34ch; font-size: var(--t-lead); line-height: 1.6; }

  .look__spec { margin: 1rem 0 0; width: 100%; border-top: 1px solid var(--line); }
  .look__spec > div { padding-block: .95rem; border-bottom: 1px solid var(--line); }
  .look__spec dt { margin-bottom: .4rem; }
  .look__spec dd { margin: 0; font-size: var(--t-small); color: var(--ink-muted); }

  .look__acts { display: flex; flex-direction: column; align-items: flex-start; gap: 1.4rem; margin-top: 1rem; }

  .related__head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .related__head h2 { margin: 0; }
  .related__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 3.5vw, 3rem); }

  @media (max-width: 900px) {
    .look__in { grid-template-columns: 1fr; }
    .look__sticky { position: static; }
    .related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .related__grid { grid-template-columns: 1fr; gap: 2.75rem; }
  }
</style>
