---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Plate from '~/components/Plate.astro';
import { collections } from '~/data/collections';
import { site, location } from '~/config/site';

const schema = {
  '@type': 'AboutPage',
  name: `About — ${site.name}`,
  url: `${site.url}/about`,
  description: `About the ${site.name} atelier.`,
  isPartOf: { '@id': `${site.url}/#website` },
  mainEntity: { '@id': `${site.url}/#organization` },
};
---

<Base
  title="About"
  description={`${site.name} is a made-to-measure atelier in ${location.city}, working across bridal, evening and couture. Where elegance meets luxury.`}
  schema={schema}
>
  <PageHero
    eyebrow="The atelier"
    title="Where elegance"
    accent="meets luxury"
    lead="Elite Evening Design is a made-to-measure atelier. Bridal, evening and couture — each piece drawn, cut and fitted for the person who will wear it."
  />

  <!-- ——— statement ——— -->
  <section class="section section--tight story" aria-labelledby="story-h">
    <div class="wrap story__in">
      <div class="story__mark reveal">
        <img src="/brand/seal.webp" width="132" height="132" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="story__text reveal" style="--reveal-delay:80ms">
        <h2 class="t-h2 story__h" id="story-h">A house built on fit</h2>
        <p>
          The work begins where ready-to-wear stops. A dress that is cut for one body behaves
          differently: it sits where it should, moves the way it was drawn to, and does not ask
          the person wearing it to adjust anything.
        </p>
        <p>
          That is the whole ambition here. Elegance is not an ornament added at the end — it is
          the result of proportion decided early and held all the way through construction.
        </p>
        <p>
          Every commission passes through the same hands, from the first sketch to the final
          press, and nothing leaves the atelier before it fits.
        </p>
      </div>
    </div>
  </section>

  <!-- ——— principles ——— -->
  <section class="section principles ink" aria-labelledby="prin-h">
    <div class="wrap">
      <div class="principles__head">
        <p class="label eyebrow reveal">Approach</p>
        <h2 class="t-display principles__h reveal" id="prin-h" style="--reveal-delay:60ms">
          Four things that <span class="t-italic principles__accent">do not change</span>
        </h2>
      </div>
      <ul class="principles__grid">
        {[
          ['Made to measure', 'No commission starts from a size. It starts from a set of measurements and a conversation.'],
          ['Fit before finish', 'Surface work is only convincing on a garment that already sits correctly. The shape is settled first.'],
          ['Hand finishing', 'Hems, closures and inner structure are completed by hand, where the difference is felt rather than seen.'],
          ['One client at a time', 'Each piece is given the attention of a single project, because that is what it is.'],
        ].map(([t, d], i) => (
          <li class="principles__item reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="label label--gold principles__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="principles__t">{t}</h3>
            <p class="principles__d">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ——— the lines ——— -->
  <section class="section section--tight lines" aria-labelledby="lines-h">
    <div class="wrap">
      <div class="lines__head reveal">
        <h2 class="t-h2" id="lines-h">What the atelier makes</h2>
        <a class="link" href="/collections">All collections <span class="arw" aria-hidden="true">&#8594;</span></a>
      </div>
      <ul class="lines__grid">
        {collections.map((c, i) => (
          <li class="lines__item reveal" style={`--reveal-delay:${i * 80}ms`}>
            <a href={`/collections/${c.slug}`}>
              <Plate {...c.cover} sizes="(max-width: 720px) 88vw, 30vw" class="lines__plate" />
              <h3 class="t-h3 lines__name">{c.name}</h3>
              <p class="lines__d">{c.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ——— cta ——— -->
  <section class="section--tight about-cta" aria-labelledby="acta-h">
    <div class="wrap about-cta__in">
      <h2 class="t-h2 about-cta__h reveal" id="acta-h">
        Commissions are open <span class="t-italic about-cta__accent">by enquiry</span>
      </h2>
      <div class="reveal" style="--reveal-delay:80ms">
        <a class="cta cta--solid" href="/contact">
          {site.bookingPhrase} <span class="arw" aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story__in {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .story__mark img { width: clamp(92px, 11vw, 132px); height: auto; border-radius: 50%; }
  .story__h { margin: 0 0 1.5rem; }
  .story__text p { color: var(--ink-muted); max-width: 58ch; }
  .story__text p + p { margin-top: 1.1em; }

  .principles__head { display: flex; flex-direction: column; align-items: flex-start; gap: 1.35rem; }
  .principles__h { margin: 0; max-width: 16ch; }
  .principles__accent { color: var(--gold-lit); }
  .principles__grid {
    list-style: none;
    margin: clamp(2.5rem, 6vh, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }
  .principles__item { border-top: 1px solid var(--line-on-ink); padding-top: 1.35rem; }
  .principles__n { display: block; margin-bottom: 1rem; }
  .principles__t { font-family: var(--serif); font-weight: 300; font-size: clamp(1.2rem, 2vw, 1.5rem); margin: 0 0 .55rem; }
  .principles__d { color: var(--on-ink-muted); font-size: var(--t-small); line-height: 1.65; }

  .lines__head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 1.25rem; border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2.5rem, 6vh, 3.5rem);
  }
  .lines__head h2 { margin: 0; }
  .lines__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .lines__item a:hover :global(.lines__plate img) { transform: scale(1.04); }
  .lines__name { margin: 1.15rem 0 .5rem; }
  .lines__d { color: var(--ink-muted); font-size: var(--t-small); max-width: 34ch; }

  .about-cta__in { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.75rem; }
  .about-cta__h { margin: 0; max-width: 20ch; }
  .about-cta__accent { color: var(--gold-ink); }

  @media (max-width: 980px) {
    .principles__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .story__in { grid-template-columns: 1fr; gap: 1.75rem; }
    .lines__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  @media (max-width: 520px) {
    .principles__grid { grid-template-columns: 1fr; }
  }
</style>
