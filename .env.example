# ─────────────────────────────────────────────────────────────────────────────
# The website (Render static site)
# ─────────────────────────────────────────────────────────────────────────────
SITE_URL=https://elite-evening-design.onrender.com
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Origin of the payment service below. While it is empty the site sells nothing
# online: a priced piece falls back to the atelier's hosted link or to WhatsApp.
PAYMENT_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# The payment service (server/ — Render web service)
# Real values belong in Render's environment, never in this file or in Git.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# stripe · local-il · mock   (mock is for development only — it takes no money)
PAYMENT_PROVIDER=stripe
PAYMENT_CURRENCY=ILS

# Where the site lives. The only origin allowed to start a payment.
SITE_URL=https://elite-evening-design.onrender.com
# Where this service lives. The gateway posts its webhooks to
#   $PAYMENT_BASE_URL/api/webhooks/$PAYMENT_PROVIDER
PAYMENT_BASE_URL=https://elite-evening-payments.onrender.com
PAYMENT_RETURN_URL=https://elite-evening-design.onrender.com/payment/success
PAYMENT_CANCEL_URL=https://elite-evening-design.onrender.com/payment/cancelled

# Secret key of the gateway. Stripe: sk_live_… (sk_test_… while testing)
PAYMENT_SERVER_KEY=
# Signing secret of the webhook endpoint. Stripe: whsec_…
PAYMENT_WEBHOOK_SECRET=

# Postgres. Render fills this in when the database is attached.
DATABASE_URL=

# Bearer token for GET /api/admin/payments. Generate a long random one.
ADMIN_TOKEN=
